	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Google AdMob App ID — এখানে Google-এর অফিসিয়াল টেস্ট App ID বসানো আছে।
	     App Store এ প্রকাশ করার আগে অবশ্যই এটি আপনার নিজের AdMob অ্যাকাউন্টের
	     আসল App ID দিয়ে পরিবর্তন করে নিন। -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>আপনার আগ্রহ অনুযায়ী প্রাসঙ্গিক বিজ্ঞাপন দেখানোর জন্য এই ডেটা ব্যবহার করা হবে।</string>
	<!-- GSM Scanner ফিচারের ইন-অ্যাপ ক্যামেরার জন্য (iOS-এ এই বার্তা ছাড়া
	     ক্যামেরা পারমিশন চাইলেই অ্যাপ ক্র্যাশ করবে) -->
	<key>NSCameraUsageDescription</key>
	<string>ফেব্রিকের GSM ট্যাগ স্ক্যান করার জন্য ক্যামেরা ব্যবহার করা হবে।</string>
	<!-- 🤖 AI Settings থেকে Google AI Studio ব্রাউজারে ওপেন করার জন্য (url_launcher) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>http</string>
		<string>https</string>
	</array>
</dict>
</plist>
